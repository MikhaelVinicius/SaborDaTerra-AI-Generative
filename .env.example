# Copie para .env e preencha. NUNCA faça commit do .env.

# Chave do Gemini (AI Studio). No Cloud Run ela vem do Secret Manager.
GEMINI_API_KEY=coloque_sua_chave_aqui
# Alternativa: Vertex AI (deixe GEMINI_API_KEY vazio)
# GOOGLE_CLOUD_PROJECT=seu-projeto-id
# GOOGLE_CLOUD_LOCATION=global

# --- Interface e orquestrador (Cloud/Fullstack/DevOps) ---
GEMINI_MODEL=gemini-3.5-flash
# Módulos que expõem ferramentas ao assistente (cada colega adiciona o seu)
TOOL_MODULES=sabor_rag.tool,sabor_triagem.tool,sabor_agentes.tool,sabor_dados.tool
# Prompt de sistema escrito pelo(a) Arquiteto(a) de Prompts
SYSTEM_PROMPT_FILE=prompts/system_prompt.md
APP_PASSWORD=
MOSTRAR_FERRAMENTAS=1
